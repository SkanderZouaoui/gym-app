DATABASE_URL="postgresql://muscleup:muscleup@localhost:5432/muscleup?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="30d"

# Chiffrement au repos des clés privées de signature QR (section 8.4/13)
QR_KEY_ENCRYPTION_SECRET="change-me-qr-key-encryption-secret"

PORT=3000

# Stockage objet S3-compatible (Garage — voir /minio). Utilisé à partir du
# module files. Les clés sont générées par minio/init.sh (garage key create).
S3_ENDPOINT="http://localhost:9000"
# Hôte joignable depuis un appareil mobile (téléphone/simulateur) pour les
# URLs présignées d'upload/lecture — doit pointer vers l'IP LAN de la
# machine de dev si elle diffère de localhost (même valeur d'hôte que
# EXPO_PUBLIC_API_URL côté mobile, port Garage 9000).
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="garage"
S3_ACCESS_KEY_ID="change-me"
S3_SECRET_ACCESS_KEY="change-me"
S3_BUCKET="muscleup"
S3_FORCE_PATH_STYLE=true

REDIS_URL="redis://localhost:6379"
