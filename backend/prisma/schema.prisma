generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organisation (section 8.1)
// ---------------------------------------------------------------------------

model OrganizationSettings {
  id               String   @id @default(uuid())
  name             String
  branding         Json     @default("{}")
  features         Json     @default("{}")
  attendancePolicy Json     @map("attendance_policy")
  /// Contact, horaires, moyens de paiement, annonces, réservation (voir OrganizationConfig côté API).
  config           Json     @default("{}")
  version          Int      @default(1)
  updatedBy        String?  @map("updated_by")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("organization_settings")
}

model Room {
  id       String @id @default(uuid())
  name     String
  capacity Int

  classTemplates ClassTemplate[]
  classSessions  ClassSession[]

  @@map("rooms")
}

// ---------------------------------------------------------------------------
// Utilisateurs (section 8.2)
// ---------------------------------------------------------------------------

enum RoleName {
  MEMBER
  COACH
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id           String     @id @default(uuid())
  email        String?    @unique
  phone        String?    @unique
  passwordHash String     @map("password_hash")
  /** Code personnel à 6 chiffres : pointage manuel à l'accueil (affiché dans le profil de l'adhérent). */
  memberCode   String?    @unique @map("member_code")
  /** Mot de passe provisoire communiqué par l'accueil/admin : à remplacer à la première connexion. */
  mustChangePassword Boolean @default(false) @map("must_change_password")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  photoKey     String?    @map("photo_key")
  status       UserStatus @default(ACTIVE)
  consents     Json       @default("{}")
  /** Fin de l'onboarding adhérent (objectif, profil physique) ; null tant qu'il n'est pas rempli. */
  onboardedAt    DateTime? @map("onboarded_at")
  /** Objectif et profil physique saisis à l'onboarding (goal, gender, heightCm, age, level, sessionsPerWeek). */
  fitnessProfile Json?     @map("fitness_profile")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  roles                   UserRole[]
  coachProfile            CoachProfile?
  deviceTokens            DeviceToken[]
  memberships             Membership[]
  recordedPayments        Payment[]       @relation("RecordedByUser")
  bookings                Booking[]
  checkedInBookings       Booking[]       @relation("CheckedInByUser")
  refreshTokens           RefreshToken[]
  otpCodes                OtpCode[]
  notifications           Notification[]
  announcementsCreated    Announcement[]  @relation("AnnouncementCreatedBy")
  notesReceived           MemberNote[]    @relation("MemberNoteUser")
  notesAuthored           MemberNote[]    @relation("MemberNoteAuthor")
  exercisesCreated        Exercise[]      @relation("ExerciseCreatedBy")
  programsCreated         Program[]       @relation("ProgramCreatedBy")
  programsAssigned        Program[]       @relation("ProgramAssignedTo")
  workoutLogs             WorkoutLog[]
  bodyMetrics             BodyMetric[]
  publishedConfigVersions AppConfigVersion[]

  workShifts WorkShift[]

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      RoleName
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

enum CoachStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model CoachProfile {
  userId          String      @id @map("user_id")
  bio             String?
  specialties     String[]
  yearsExperience Int?        @map("years_experience")
  status          CoachStatus @default(ACTIVE)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  classTemplates ClassTemplate[]
  classSessions  ClassSession[]

  @@map("coach_profiles")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum OtpPurpose {
  PASSWORD_RESET
  EMAIL_CHANGE
}

/**
 * Code à usage unique (6 chiffres) envoyé par e-mail — mot de passe oublié
 * et changement d'e-mail (section Compte/Profil). Vérifié paresseusement via
 * expiresAt/consumedAt, même convention que RefreshToken/UsedQrToken : pas de
 * cron de nettoyage.
 */
model OtpCode {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  /// Essais de saisie déjà consommés ; le code est verrouillé à OTP_MAX_ATTEMPTS.
  attempts   Int        @default(0)
  newEmail   String?    @map("new_email")
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

// ---------------------------------------------------------------------------
// Abonnements et encaissements (section 8.3)
// ---------------------------------------------------------------------------

model MembershipPlan {
  id              String   @id @default(uuid())
  name            String
  description     String?
  durationDays    Int      @map("duration_days")
  price           Decimal  @db.Decimal(10, 2)
  accessCount     Int?     @map("access_count") // null = illimité
  isContractual   Boolean  @default(false) @map("is_contractual")
  isActive        Boolean  @default(true) @map("is_active")
  isVisibleInApp  Boolean  @default(true) @map("is_visible_in_app") // visible dans le catalogue adhérent
  isPopular       Boolean  @default(false) @map("is_popular") // badge "Populaire" dans l'app
  includesLabel   String?  @map("includes_label") // ex. "Accès libre + 2 invitations / mois"
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  memberships   Membership[]
  announcements Announcement[]

  @@map("membership_plans")
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

model Membership {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  planId    String           @map("plan_id")
  startDate DateTime         @map("start_date")
  endDate   DateTime         @map("end_date")
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     MembershipPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@map("memberships")
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  OTHER
}

model Payment {
  id                  String        @id @default(uuid())
  membershipId        String        @map("membership_id")
  amount              Decimal       @db.Decimal(10, 2)
  method              PaymentMethod
  recordedById        String        @map("recorded_by")
  recordedAt          DateTime      @default(now()) @map("recorded_at")
  reference           String?
  externalProviderRef String?       @map("external_provider_ref")
  deletedAt           DateTime?     @map("deleted_at")

  membership Membership @relation(fields: [membershipId], references: [id])
  recordedBy User       @relation("RecordedByUser", fields: [recordedById], references: [id])

  @@index([membershipId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Cours, réservations et présence (section 8.4)
// ---------------------------------------------------------------------------

model ClassType {
  id             String  @id @default(uuid())
  name           String
  description    String?
  level          String?
  imageKey       String? @map("image_key")
  isActive       Boolean @default(true) @map("is_active")
  icon           String  @default("fitness_center") // pictogramme Material Symbols (app + back-office)
  tone           String  @default("primary") // couleur de badge (primary|secondary|accent|success|info|warning|danger)
  isBookable     Boolean @default(true) @map("is_bookable") // visible/réservable dans l'app adhérent
  defaultCapacity Int    @default(16) @map("default_capacity")
  defaultDurationMin Int @default(45) @map("default_duration_min")
  galleryKeys    String[] @default([]) @map("gallery_keys") // clés S3 des photos du cours (galerie de la fiche cours)

  templates ClassTemplate[]
  sessions  ClassSession[]

  @@map("class_types")
}

enum RecurrenceFrequency {
  WEEKLY
}

model ClassTemplate {
  id          String              @id @default(uuid())
  classTypeId String              @map("class_type_id")
  roomId      String?             @map("room_id")
  coachId     String?             @map("coach_id")
  capacity    Int
  frequency   RecurrenceFrequency @default(WEEKLY)
  dayOfWeek   Int                 @map("day_of_week") // 0 (dimanche) à 6
  startTime   String              @map("start_time") // "HH:mm"
  durationMin Int                 @map("duration_min")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")

  classType ClassType      @relation(fields: [classTypeId], references: [id])
  room      Room?          @relation(fields: [roomId], references: [id])
  coach     CoachProfile?  @relation(fields: [coachId], references: [userId])
  sessions  ClassSession[]

  @@map("class_templates")
}

enum ClassSessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

model ClassSession {
  id                String             @id @default(uuid())
  templateId        String?            @map("template_id")
  classTypeId       String             @map("class_type_id")
  roomId            String?            @map("room_id")
  coachId           String?            @map("coach_id")
  startsAt          DateTime           @map("starts_at")
  endsAt            DateTime           @map("ends_at")
  capacity          Int
  status            ClassSessionStatus @default(SCHEDULED)
  cancelledAt       DateTime?          @map("cancelled_at")
  cancelledReason   String?            @map("cancelled_reason")
  noShowProcessedAt DateTime?          @map("no_show_processed_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  template  ClassTemplate?      @relation(fields: [templateId], references: [id])
  classType ClassType           @relation(fields: [classTypeId], references: [id])
  room      Room?               @relation(fields: [roomId], references: [id])
  coach     CoachProfile?       @relation(fields: [coachId], references: [userId])
  bookings  Booking[]
  scanLogs  AttendanceScanLog[]

  @@index([startsAt])
  @@index([coachId, startsAt])
  @@map("class_sessions")
}

enum BookingStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum CheckInMethod {
  QR
  MANUAL
  WALK_IN
}

model Booking {
  id               String         @id @default(uuid())
  sessionId        String         @map("session_id")
  userId           String         @map("user_id")
  status           BookingStatus  @default(CONFIRMED)
  waitlistPosition Int?           @map("waitlist_position")
  bookingCode      String         @unique @map("booking_code") // 6 caractères
  attendedAt       DateTime?      @map("attended_at")
  checkedInBy      String?        @map("checked_in_by")
  checkInMethod    CheckInMethod? @map("check_in_method")
  createdAt        DateTime       @default(now()) @map("created_at")
  cancelledAt      DateTime?      @map("cancelled_at")

  session         ClassSession @relation(fields: [sessionId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  checkedInByUser User?        @relation("CheckedInByUser", fields: [checkedInBy], references: [id])

  // Pas d'unicité (sessionId, userId) globale : un adhérent peut avoir
  // plusieurs réservations CANCELLED sur la même séance au fil du temps
  // (annulation puis nouvelle réservation). L'unicité ne doit porter que
  // sur les réservations actives — index partiel ajouté en SQL manuel
  // dans la migration (voir prisma/migrations/.../migration.sql).
  @@index([sessionId])
  @@index([userId])
  @@index([bookingCode])
  @@map("bookings")
}

model AttendanceScanLog {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  userId     String?  @map("user_id")
  scannedBy  String   @map("scanned_by")
  result     String // GRANTED | DENIED
  reasonCode String   @map("reason_code")
  offline    Boolean  @default(false)
  scannedAt  DateTime @default(now()) @map("scanned_at")

  session ClassSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, scannedAt])
  @@map("attendance_scan_logs")
}

enum QrSigningKeyStatus {
  ACTIVE
  ROTATED
  REVOKED
}

model QrSigningKey {
  kid           String             @id
  publicKey     String             @map("public_key")
  privateKeyEnc String             @map("private_key_enc") // chiffrée au repos
  status        QrSigningKeyStatus @default(ACTIVE)
  createdAt     DateTime           @default(now()) @map("created_at")
  rotatedAt     DateTime?          @map("rotated_at")

  @@map("qr_signing_keys")
}

model UsedQrToken {
  jti       String   @id
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("used_qr_tokens")
}

// ---------------------------------------------------------------------------
// Coaching et entraînement (section 8.5)
// ---------------------------------------------------------------------------

enum ExerciseType {
  STRENGTH
  CARDIO
  MOBILITY
}

model Exercise {
  id           String       @id @default(uuid())
  name         String
  muscleGroup  String?      @map("muscle_group")
  equipment    String?
  mediaKey     String?      @map("media_key")
  instructions String?
  createdById  String?      @map("created_by")
  isActive     Boolean      @default(true) @map("is_active")
  type         ExerciseType @default(STRENGTH)
  level        String?

  createdBy        User?             @relation("ExerciseCreatedBy", fields: [createdById], references: [id])
  programExercises ProgramExercise[]
  workoutSets      WorkoutSet[]

  @@map("exercises")
}

enum ProgramStatus {
  PENDING // soumis par un coach, en attente de validation de l'admin
  APPROVED
  REJECTED
}

model Program {
  id           String    @id @default(uuid())
  name         String
  createdById  String    @map("created_by")
  assignedToId String    @map("assigned_to")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  level        String? // Débutant | Intermédiaire | Avancé
  goal         String? // Perte de poids | Masse | Endurance | Mobilité
  status       ProgramStatus @default(APPROVED)
  rejectionNote String?  @map("rejection_note")
  /** Visible par tous les adhérents une fois validé (rubrique « Proposés »). */
  isPublic     Boolean   @default(false) @map("is_public")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  createdBy   User         @relation("ProgramCreatedBy", fields: [createdById], references: [id])
  assignedTo  User         @relation("ProgramAssignedTo", fields: [assignedToId], references: [id])
  days        ProgramDay[]
  workoutLogs WorkoutLog[]

  @@index([assignedToId])
  @@index([status, isPublic])
  @@map("programs")
}

model ProgramDay {
  id        String  @id @default(uuid())
  programId String  @map("program_id")
  dayOfWeek Int     @map("day_of_week") // 0-6
  label     String?

  program     Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises   ProgramExercise[]
  workoutLogs WorkoutLog[]

  @@index([programId])
  @@map("program_days")
}

model ProgramExercise {
  id           String  @id @default(uuid())
  programDayId String  @map("program_day_id")
  exerciseId   String  @map("exercise_id")
  order        Int     @default(0)
  sets         Int // résumé rapide (nombre de séries) — le détail par série vit dans `setDetails`
  reps         String // résumé rapide, ex. "8-12" ou "AMRAP"
  restSeconds  Int?    @map("rest_seconds")
  notes        String?

  programDay ProgramDay           @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  exercise   Exercise             @relation(fields: [exerciseId], references: [id])
  setDetails ProgramExerciseSet[]

  @@index([programDayId])
  @@map("program_exercises")
}

/**
 * Détail personnalisable d'une série (reps et poids propres à chaque série,
 * au lieu d'un réglage unique répété sur toutes les séries).
 */
model ProgramExerciseSet {
  id                String   @id @default(uuid())
  programExerciseId String   @map("program_exercise_id")
  setNumber         Int      @map("set_number")
  reps              Int?
  weightKg          Decimal? @map("weight_kg") @db.Decimal(6, 2)
  restSeconds       Int?     @map("rest_seconds")

  programExercise ProgramExercise @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)

  @@index([programExerciseId])
  @@map("program_exercise_sets")
}

model WorkoutLog {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  programId       String?  @map("program_id")
  dayId           String?  @map("day_id")
  date            DateTime @default(now())
  feeling         String? // ressenti libre
  durationMinutes Int?     @map("duration_minutes")
  durationSeconds Int?     @map("duration_seconds") // durée exacte ; durationMinutes en reste l'arrondi
  createdAt       DateTime @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program?     @relation(fields: [programId], references: [id])
  day     ProgramDay?  @relation(fields: [dayId], references: [id])
  sets    WorkoutSet[]

  @@index([userId, date])
  @@map("workout_logs")
}

model WorkoutSet {
  id           String   @id @default(uuid())
  workoutLogId String   @map("workout_log_id")
  exerciseId   String   @map("exercise_id")
  setNumber    Int      @map("set_number")
  weightKg     Decimal? @map("weight_kg") @db.Decimal(6, 2)
  reps         Int?
  rpe          Int? // ressenti d'effort 1-10

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id])

  @@index([workoutLogId])
  @@map("workout_sets")
}

/**
 * Mesures corporelles — accès restreint (section 13).
 */
model BodyMetric {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  date         DateTime @default(now())
  weightKg     Decimal? @map("weight_kg") @db.Decimal(5, 2)
  measurements Json?    @default("{}")
  visibility   String   @default("PRIVATE") // PRIVATE | SHARED_WITH_COACH
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("body_metrics")
}

// ---------------------------------------------------------------------------
// Communication et modération (section 8.7, socle phase 3)
// ---------------------------------------------------------------------------

enum NotificationType {
  CLASS_REMINDER
  WAITLIST_PROMOTED
  MEMBERSHIP_EXPIRING
  ANNOUNCEMENT
  ATTENDANCE_CONFIRMED
  PERSONAL_RECORD
  ADMIN_PAYMENT
  ADMIN_NEW_MEMBER
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/**
 * Alerte affichée en haut de l'accueil adhérent (fermeture exceptionnelle, travaux, panne…).
 * Distincte des annonces : pas de notification, mais une période d'affichage et une audience.
 */
model HomeAlert {
  id        String   @id @default(uuid())
  title     String
  message   String
  level     String   @default("info") // info | warn | urgent
  audience  String   @default("Tous") // Tous | Actifs | Expirés
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isActive, startsOn, endsOn])
  @@map("home_alerts")
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  body        String
  planId      String?   @map("plan_id") // ciblage par formule
  tone        String    @default("info") // style de bannière dans l'app : info|accent|danger
  createdById String    @map("created_by")
  sentAt      DateTime? @map("sent_at")
  /// Période d'affichage sur l'accueil adhérent (null = sans limite).
  startsOn    DateTime? @map("starts_on") @db.Date
  endsOn      DateTime? @map("ends_on") @db.Date
  push        Boolean   @default(true)
  /// Destinataires : MEMBERS (adhérents, filtrés par formule) | STAFF | COACH | TEAM (accueil + coachs) | ALL.
  audience    String    @default("MEMBERS")
  createdAt   DateTime  @default(now()) @map("created_at")

  plan      MembershipPlan? @relation(fields: [planId], references: [id])
  createdBy User            @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])

  @@map("announcements")
}

/**
 * Notes libres sur un adhérent, visibles par staff/coach/admin (section 10.5).
 */
model MemberNote {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  user   User @relation("MemberNoteUser", fields: [userId], references: [id], onDelete: Cascade)
  author User @relation("MemberNoteAuthor", fields: [authorId], references: [id])

  @@index([userId])
  @@map("member_notes")
}

// ---------------------------------------------------------------------------
// Audit (section 8.8) — socle
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Configuration de l'app mobile (back-office "CMS") — brouillon + publication
// ---------------------------------------------------------------------------

enum AppConfigStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/**
 * Snapshot versionné de toute la configuration consommée par l'app mobile :
 * branding, blocs d'accueil, onglets, textes i18n, notifications auto,
 * règles de réservation/accès et permissions de rôle. Il existe toujours
 * exactement un DRAFT (modifiable librement) et au plus un PUBLISHED actif
 * (celui que l'app mobile lit via /v1/config). Publier = dupliquer le
 * contenu du draft vers une nouvelle version PUBLISHED (les anciennes
 * passent en ARCHIVED) ; le draft continue ensuite depuis cette base.
 */
model AppConfigVersion {
  id              String           @id @default(uuid())
  status          AppConfigStatus  @default(DRAFT)
  versionNumber   Int              @map("version_number") // 0 pour le draft courant, 1..n pour les publications
  note            String?
  branding        Json             @default("{}")
  homeModules     Json             @default("[]") @map("home_modules")
  tabs            Json             @default("[]")
  strings         Json             @default("[]")
  languages       Json             @default("{}")
  notifSettings   Json             @default("{}") @map("notif_settings")
  bookingRules    Json             @default("{}") @map("booking_rules")
  changedKeys     Json             @default("[]") @map("changed_keys") // clés modifiées depuis la dernière publication (brouillon courant)
  publishedById   String?          @map("published_by")
  publishedAt     DateTime?        @map("published_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  publishedBy User? @relation(fields: [publishedById], references: [id])

  @@index([status])
  @@map("app_config_versions")
}

/**
 * Matrice permission × rôle éditable depuis le back-office (section
 * "Rôles & permissions"). Les permissions ADMIN restent toujours vraies
 * côté backend (non pilotées par cette table) ; elle sert à restreindre
 * MEMBER/COACH/STAFF/MANAGER au-delà du socle @Roles() déjà en place.
 */
model RolePermission {
  id         String   @id @default(uuid())
  permission String // ex. "classes.cancel", "payments.record"
  role       RoleName
  allowed    Boolean  @default(false)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([permission, role])
  @@map("role_permissions")
}


/// Notification push composée par l'admin : envoyée tout de suite (SENT) ou programmée (PENDING).
model ScheduledNotification {
  id          String    @id @default(uuid())
  kind        String    @default("Annonce") // Annonce | Rappel | Offre
  title       String
  body        String
  audience    String    @default("ALL") // ALL | ACTIVE | EXPIRING | EXPIRED | PLAN:<id>
  sendAt      DateTime  @map("send_at")
  status      String    @default("PENDING") // PENDING | SENT | CANCELLED
  sentCount   Int       @default(0) @map("sent_count")
  sentAt      DateTime? @map("sent_at")
  createdById String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status, sendAt])
  @@map("scheduled_notifications")
}

/// Règle d'envoi récurrente : certains jours, à une heure donnée, selon une condition.
model NotificationRule {
  id          String    @id @default(uuid())
  title       String
  body        String
  audience    String    @default("ALL")
  condition   String    @default("NONE") // NONE | EXPIRES_7D | ABSENT_14D | CLASS_TOMORROW
  days        Int[] // 0 = lundi … 6 = dimanche
  time        String // HH:mm
  isActive    Boolean   @default(true) @map("is_active")
  lastRunOn   DateTime? @map("last_run_on") @db.Date
  createdById String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("notification_rules")
}

/// Planning de travail hebdomadaire d'un membre de l'équipe (accueil, coach) : un créneau par jour, répété chaque semaine.
model WorkShift {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  dayOfWeek Int    @map("day_of_week") // 0 = lundi … 6 = dimanche
  startTime String @map("start_time") // HH:mm
  endTime   String @map("end_time") // HH:mm

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@map("work_shifts")
}
