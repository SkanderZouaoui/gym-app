# Configuration de déploiement pour le client "exemple" (section 14.1).
# Copier ce fichier en .env dans ce même dossier, remplir les valeurs,
# puis lancer :
#   docker compose -f docker-compose.prod.yml --env-file deploy/clients/exemple/.env up -d

# --- Infra ---
POSTGRES_USER=muscleup
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=muscleup
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_API_PORT=9000
MINIO_ADMIN_PORT=9001
# Écoute du stockage S3 : 127.0.0.1 en prod (accès uniquement via le reverse proxy TLS)
MINIO_BIND=127.0.0.1
# Secrets Garage (générés par onboard-client.sh si vides)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

API_PORT=3000

# --- Secrets applicatifs (générer avec `openssl rand -hex 32`) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d
QR_KEY_ENCRYPTION_SECRET=

# --- Stockage S3 (Garage) — générés par minio/init.sh après le premier démarrage ---
# URL publique https du stockage, joignable par les téléphones (ex. https://files.client.com)
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=muscleup

# --- Branding (section 14.3) ---
CLIENT_NAME="Nom de la salle"
CLIENT_DOMAIN=exemple.muscleup.app

# --- Notifications push (section 14.3 : un projet Firebase par client) ---
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=

# --- Observabilité (section 14.4) ---
SENTRY_DSN=

# Origines autorisées du backoffice (séparées par des virgules), ex: https://admin.client.com
CORS_ORIGINS=
# Nombre de reverse proxies devant l API (1 si Caddy/Nginx), pour le rate limiting par IP
TRUST_PROXY=1

# --- E-mails (OBLIGATOIRE en prod : sans SMTP, le mot de passe oublié ne fonctionne pas) ---
SMTP_HOST=
SMTP_PORT=587
# true pour TLS implicite (port 465), false pour STARTTLS (587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nom de la salle <no-reply@domaine-du-client.com>"
MAIL_BRAND=Nom de la salle

# URL publique de l'API (ex: https://api.client.com) : sert au lien « Ouvrir l'application » des e-mails
PUBLIC_API_URL=
