{
  "expo": {
    "name": "MuscleUP",
    "slug": "muscleup",
    "scheme": "muscleup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.torealco.muscleup",
      "infoPlist": {
        "NSFaceIDUsageDescription": "MuscleUP utilise Face ID pour vous connecter rapidement et en toute sécurité.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "KCG4GUSTSW"
    },
    "android": {
      "package": "com.muscleup.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MuscleUP a besoin de la caméra pour scanner les QR de présence aux cours."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MuscleUP a besoin d'accéder à vos photos pour changer votre photo de profil.",
          "cameraPermission": "MuscleUP a besoin de l'appareil photo pour prendre une photo de votre séance."
        }
      ],
      "expo-video",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MuscleUP utilise Face ID pour vous connecter rapidement et en toute sécurité."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#7C3AED"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53772433-a892-477a-9217-85860d08cc70"
      }
    },
    "owner": "mohamedskanderzouaoui"
  }
}
