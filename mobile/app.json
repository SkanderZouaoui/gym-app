{
  "expo": {
    "name": "MuscleUP",
    "slug": "muscleup",
    "scheme": "muscleup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muscleup.app"
    },
    "android": {
      "package": "com.muscleup.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "MuscleUP a besoin de la caméra pour scanner les QR de présence aux cours."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MuscleUP a besoin d'accéder à vos photos pour changer votre photo de profil.",
          "cameraPermission": "MuscleUP a besoin de l'appareil photo pour prendre une photo de votre séance."
        }
      ],
      "expo-video"
    ]
  }
}
